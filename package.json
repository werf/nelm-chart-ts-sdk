{
  "name": "@nelm/chart-ts-sdk",
  "version": "0.1.5",
  "description": "The Nelm TypeScript SDK for generating Kubernetes manifests with TypeScript instead of Helm templates",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "nelm",
    "werf",
    "helm",
    "kubernetes",
    "types",
    "typescript",
    "deno"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/werf/nelm-chart-ts-sdk.git"
  },
  "homepage": "https://github.com/werf/nelm-chart-ts-sdk#readme",
  "bugs": {
    "url": "https://github.com/werf/nelm-chart-ts-sdk/issues"
  },
  "contributors": [
    "ilya-lesikov",
    "alexey-igrychev"
  ],
  "devDependencies": {
    "@types/deno": "^2.5.0",
    "@types/node": "^25.2.3",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@std/yaml": "npm:@jsr/std__yaml@^1.0.12"
  }
}
